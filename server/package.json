{
  "name": "chatterly",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run db:ensure:dev && NODE_ENV=development tsx src/index.ts",
    "test": "npm run db:ensure:test && NODE_ENV=test jest",
    "test:unit": "npm run db:ensure:test && NODE_ENV=test jest --runInBand --detectOpenHandles tests/unit",
    "test:integration": "npm run db:ensure:test && NODE_ENV=test jest --runInBand --detectOpenHandles tests/integration",
    "start": "NODE_ENV=production tsx src/index.ts",
    "test:watch": "NODE_ENV=test jest --watch && npm run db:ensure:test",
    "migrate:dev": "dotenv -e .env.development -- prisma migrate dev --schema=./prisma/schema.prisma",
    "migrate:test": "dotenv -e .env.test -- prisma migrate dev --schema=./prisma/schema.prisma",
    "db:ensure:dev": "dotenv -e .env.development -- prisma migrate deploy --schema=./prisma/schema.prisma || npm run migrate:dev",
    "db:ensure:test": "dotenv -e .env.test -- prisma migrate deploy --schema=./prisma/schema.prisma || npm run migrate:test",
    "db:setup": "npm run migrate:dev && npm run migrate:test",
    "db:reset:test": "dotenv -e .env.test -- prisma migrate reset --force --schema=./prisma/schema.prisma",
    "db:studio:dev": "dotenv -e .env.development -- prisma studio --schema=./prisma/schema.prisma",
    "db:studio:test": "dotenv -e .env.test -- prisma studio --schema=./prisma/schema.prisma",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier \"{src,test,config,.}/**/*.{ts,js,json,md}\" --write",
    "lint-and-format": "npm run lint:fix && npm run format",
    "clean": "npm run db:reset:test",
    "fresh": "npm run clean && npm run db:setup"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "dotenv-expand": "^12.0.2",
    "dotenv-flow": "^4.1.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.5",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "prisma": "^6.11.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "twilio": "^5.8.0",
    "winston": "^3.17.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.10",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^30.0.4",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  }
}
