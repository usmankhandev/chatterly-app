{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "version": "1.0.0",
  "description": "API for the project",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev",
        "cwd": "apps/api"
      }
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "main": "apps/api/src/index.ts",
        "outputPath": "dist/apps/api",
        "outputFileName": "index.js",
        "tsConfig": "apps/api/tsconfig.app.json",
        "platform": "node",
        "format": ["cjs"],
        "bundle": true,
        "assets": []
      },
      "configurations": {
        "development": {
          "minify": false
        },
        "production": {
          "minify": true
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm test",
        "cwd": "apps/api"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run lint",
        "cwd": "apps/api"
      }
    },
    "migrate:dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotenv -e apps/api/.env.development -- prisma migrate dev --schema=apps/api/prisma/schema.prisma"
      }
    },
    "migrate:test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotenv -e apps/api/.env.test -- prisma migrate deploy --schema=apps/api/prisma/schema.prisma"
      }
    },
    "migrate:prod": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotenv -e apps/api/.env.production -- prisma migrate deploy --schema=apps/api/prisma/schema.prisma"
      }
    }
  }
}
