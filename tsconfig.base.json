{
  "compileOnSave": false,
  "compilerOptions": {
    "types": ["node"],
    "typeRoots": ["node_modules/@types"],
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "shared-types": ["shared-types/src/index.ts"],
      "shared-utils": ["shared-utils/src/index.ts"],
      "config": ["config/src/index.ts"],
      "@chatterly/observability": ["libs/observability/src/index.ts"],
      "@chatterly/nest-observability": ["libs/nest-observability/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
