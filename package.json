{
  "name": "chatterly",
  "version": "1.0.0",
  "private": true,
  "description": "Chatterly Nx Monorepo",
  "main": "index.js",
  "license": "ISC",
  "scripts": {
    "dev": "nx serve api",
    "build": "nx build api",
    "start": "node dist/apps/api/main.js",
    "test": "nx test api",
    "test:watch": "nx test api --watch",
    "test:unit": "jest --runInBand --detectOpenHandles tests/unit",
    "test:integration": "jest --runInBand --detectOpenHandles tests/integration",
    "lint": "nx lint api",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier \"{apps,libs,tools,test}/**/*.{ts,js,json,md}\" --write",
    "lint-and-format": "npm run lint:fix && npm run format",
    "migrate:dev": "dotenv -e apps/api/.env.development -- prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "migrate:test": "dotenv -e apps/api/.env.test -- prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "db:ensure:dev": "dotenv -e apps/api/.env.development -- prisma migrate deploy --schema=apps/api/prisma/schema.prisma || npm run migrate:dev",
    "db:ensure:test": "dotenv -e apps/api/.env.test -- prisma migrate deploy --schema=apps/api/prisma/schema.prisma || npm run migrate:test",
    "db:setup": "npm run migrate:dev && npm run migrate:test",
    "db:reset:test": "dotenv -e apps/api/.env.test -- prisma migrate reset --force --schema=apps/api/prisma/schema.prisma",
    "db:studio:dev": "dotenv -e apps/api/.env.development -- prisma studio --schema=apps/api/prisma/schema.prisma",
    "db:studio:test": "dotenv -e apps/api/.env.test -- prisma studio --schema=apps/api/prisma/schema.prisma",
    "clean": "npm run db:reset:test",
    "fresh": "npm run clean && npm run db:setup",
    "test:socket": "tsx apps/api/src/socket/verifySocketConnection.ts",
    "graph": "nx graph",
    "affected:build": "nx affected --target=build",
    "affected:test": "nx affected --target=test",
    "affected:lint": "nx affected --target=lint"
  },
  "nx": {},
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.11.1",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "dotenv-expand": "^12.0.2",
    "dotenv-flow": "^4.1.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-vault": "^0.12.0",
    "nodemailer": "^7.0.5",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "prisma": "^6.11.1",
    "redis": "^4.6.14",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "twilio": "^5.8.0",
    "winston": "^3.17.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/esbuild": "^22.7.1",
    "@nx/eslint": "22.5.4",
    "@nx/eslint-plugin": "22.5.4",
    "@nx/jest": "22.5.4",
    "@nx/js": "22.5.4",
    "@nx/nest": "^22.5.4",
    "@nx/node": "^22.5.4",
    "@nx/web": "22.5.4",
    "@nx/webpack": "22.5.4",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.41",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-mock-extended": "^4.0.0",
    "jest-util": "^30.0.2",
    "nx": "22.5.4",
    "prettier": "~3.6.2",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  }
}
