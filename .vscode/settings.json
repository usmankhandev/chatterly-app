// Prettier Formatting Rules
{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,

  // ESLint rules for linting the code.

  "eslint.enable": true,
  "eslint.validate": ["javascript", "typescript"],
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.eslint": "explicit"
  },

  // Tailwind CSS Intellisense;

  "tailwindCSS.includeLanguages": {
    "typescript": "html",
    "typescriptreact": "javascript"
  },

  // Indentation rules

  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,

  // Language specific overrides;

  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "yaml.schemas": {
    "https://www.schemastore.org/sourcehut-build-0.65.0.json": "output:extension-output-ms-kubernetes-tools.vscode-kubernetes-tools-%231-Kubernetes",
    "https://raw.githubusercontent.com/microsoft/azure-pipelines-vscode/master/service-schema.json": "file:///home/osmankhan/solution-architect/chatterly/azure-pipelines.yml"
  }
}
